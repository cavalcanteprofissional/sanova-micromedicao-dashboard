# HuggingFace API - gratuita (credits gratuitos em https://huggingface.co)
# Gere um Access Token em Settings > Access Tokens (tipo: Read) e cole abaixo
HF_TOKEN=your_hf_token_here

# Cohere API - gratuita (https://cohere.com)
# Gere uma API Key em https://dashboard.cohere.com/ e cole abaixo
COHERE_API_KEY=your_cohere_key_here